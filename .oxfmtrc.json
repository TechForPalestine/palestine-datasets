{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "site/build",
    "site/src/generated",
    "site/static",
    "site/src/components/StoriesInData/stories-data.json"
  ]
}
